# Copy to .env and fill in. Never commit .env (see .gitignore).

# --- LLM providers ---
GOOGLE_API_KEY=                 # JUDGE only (judge_pool: gemini-3.8-flash — briefly tried
                                 # gemini-3.1-pro-preview 2026-09-27, reverted same day: zero
                                 # free-tier quota on this key/project — reserved for hard
                                 # invariant #6 cross-model-family independence since
                                 # EXTRACTOR/SUMMARIZER moved to GPT-5.1, spec.md §14.1.3).
                                 # May be a comma-separated list of keys (each from its own
                                 # Google AI Studio project) -- the free tier's 20/day quota is
                                 # per key/project/model, so N keys ~= N*20 requests/day.
                                 # src/llm/gemini_client.py stays on one key until it reports
                                 # RESOURCE_EXHAUSTED, then rotates to the next.
OPENAI_API_KEY=                 # EXTRACTOR / SUMMARIZER / REASONER (GPT-5.1 primary, GPT-5.6-Luna REASONER
                                 # fallback — all resolve from this key)
AZURE_OPENAI_BASE_URL=          # ONLY set this if OPENAI_API_KEY is a Microsoft Foundry / Azure OpenAI key,
                                 # not a platform api.openai.com key (sk-...). Format:
                                 # https://<resource-name>.services.ai.azure.com/openai/v1/  (trailing slash)
                                 # or https://<resource-name>.openai.azure.com/openai/v1/ — both work (Azure OpenAI
                                 # v1 GA API, no api-version needed). src/llm/openai_client.py passes this straight
                                 # through as ChatOpenAI's base_url when set; unset means the standard OpenAI API.
                                 # Model names in config/models.yaml (gpt-5.1, gpt-5.6-luna) must match your
                                 # Foundry DEPLOYMENT names exactly, not necessarily the underlying model name.

# --- Data layer ---
DATABASE_URL=postgresql://       # direct Postgres connection (Supabase pooler or local Docker) — needed by `make db` to apply migrations; the Supabase client below is REST-based and does not run schema migrations
SUPABASE_URL=
SUPABASE_SERVICE_KEY=           # server-side only — never load this in the Streamlit/UI process

# --- Local cache / checkpointer ---
SQLITE_CACHE_PATH=cache.db      # LLM response cache + LangGraph checkpointer db (not the domain schema — CLAUDE.md §6)

# --- Runtime flags ---
REGAGENTX_ENV=dev               # dev|demo
REGAGENTX_CACHE=off             # 'on' for demo replay (instant, offline-safe)
REGAGENTX_RUN_BUDGET_USD=0.50   # per-run cost cap enforced by ModelGateway
