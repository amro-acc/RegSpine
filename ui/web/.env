# Shared team default -- not a secret, just which local port the FastAPI
# backend runs on. Override locally in ui/web/.env.local (gitignored by
# `ui/web/*.local` in the repo root .gitignore) if this port is ever
# claimed by something outside the project on your machine, same as
# happened with 8000 then 8010 on at least one dev machine -- see
# Makefile's `api` target comment for the full story. Keep this in sync
# with Makefile's API_PORT.
VITE_API_PORT=8055
